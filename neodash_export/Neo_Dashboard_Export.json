          {
            "id": "2b46b6dd-4e6b-46da-bcf2-0b50ccada72d",
            "title": "Most Popular Chart - Top 25",
            "query": "MATCH (c:Celebrity)-[r:RELATIONSHIP]-()\nWHERE toLower(c.name) <> 'kalathma'\nWITH trim(\n  reduce(s = \"\", w IN split(toLower(c.name), \" \") |\n    s + \" \" + toUpper(substring(w, 0, 1)) + substring(w, 1)\n  )\n) AS Celebrity, count(r) AS Frequency\nRETURN Celebrity, Frequency\nORDER BY Frequency DESC\nLIMIT 25\n",
            "width": 19,
            "height": 7,
            "x": 0,
            "y": 6,
            "type": "bar",
            "selection": {
              "index": "Celebrity",
              "value": "Frequency",
