            "title": "The Full Alleged Network",
            "query": "MATCH (n)-[e]->(m)\nWHERE NOT ((n:Celebrity) AND toLower(n.name) = 'kalathma')\n  AND NOT ((m:Celebrity) AND toLower(m.name) = 'kalathma')\nRETURN n, e, m \nLIMIT 10000\n",
